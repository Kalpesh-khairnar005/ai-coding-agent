# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Free-tier alternatives (OpenAI-compatible): Groq https://api.groq.com/openai/v1 | OpenRouter https://openrouter.ai/api/v1

# Optional
MAX_REPAIR_ATTEMPTS=3
TEST_TIMEOUT=60
ALLOW_CUSTOM_PROJECT=false
# Max agent runs per browser session when the server-side key is used (protects a public deployment)
MAX_RUNS_PER_SESSION=5
LOG_LEVEL=INFO
